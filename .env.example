# Copy to .env on the server (or set these in your systemd / pm2 config).

PORT=3001
PUBLIC_URL=https://scan.qacops.com
REPORT_TTL_DAYS=30

# Email through any SMTP provider. Leave SMTP_HOST empty to print emails to the console instead.
# Brevo:  SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<your Brevo SMTP login>  SMTP_PASS=<SMTP key>
# Resend: SMTP_HOST=smtp.resend.com       SMTP_PORT=465  SMTP_USER=resend                  SMTP_PASS=<API key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="QACops <scan@qacops.com>"
OWNER_EMAIL=agha@qacops.com

# Sites allowed to send the audit form to /api/contact
CONTACT_ORIGINS=https://qacops.com,https://www.qacops.com
